@model IEnumerable<ClaseEF.Models.Paciente>
@{
    ViewData["Title"] = "Pacientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Citas</h1>
        <p class="text-muted mb-0">CRUD sobre <code>dbo.Pacientes</code> usando Entity Framework Core.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nueva Paciente</a>
</div>

<div class="table-card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Id</th>
                <th>Persona</th>
                <th>Telefono</th>
                <th>Correo</th>
                <th>Direccion</th>
                <th>Fecha Nacimiento</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                    <td>@item.NombreDeLaPersona</td>
                    <td>@item.Telefono</td>
                    <td>@item.Correo</td>
                    <td>@item.Direccion</td>
                    <td>@item.FechaNacimiento.ToString("g")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Id">Ver</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
