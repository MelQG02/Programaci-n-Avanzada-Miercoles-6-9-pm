@model ClaseEF.Models.Paciente
@{
    ViewData["Title"] = "Eliminar Paciente";
}

<div class="form-card p-4">
    <h1 class="h3 text-danger">Eliminar paciente</h1>
    <dl class="row">
        <dt class="col-sm-3">Persona</dt>
        <dd class="col-sm-9">@Model.NombreDeLaPersona</dd>
        <dt class="col-sm-3">Identificacion</dt>
        <dd class="col-sm-9">@Model.Identificacion</dd>
        <dt class="col-sm-3">Telefono</dt>
        <dd class="col-sm-9">@Model.Telefono</dd>
        <dt class="col-sm-3">Correo</dt>
        <dd class="col-sm-9">@Model.Correo</dd>
        <dt class="col-sm-3">Direccion</dt>
        <dd class="col-sm-9">@Model.Direccion</dd>
        <dt class="col-sm-3">Fecha</dt>
        <dd class="col-sm-9">@Model.FechaNacimiento.ToString("f")</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
