@model ClaseEF.ViewModels.CitaDetailsViewModel
@{
    ViewData["Title"] = "Eliminar cita";
}

<div class="form-card p-4">
    <h1 class="h3 text-danger">Eliminar cita</h1>
    <dl class="row">
        <dt class="col-sm-3">Persona</dt>
        <dd class="col-sm-9">@Model.NombrePaciente</dd>
        <dt class="col-sm-3">Servicio</dt>
        <dd class="col-sm-9">@Model.NombreServicio</dd>
        <dt class="col-sm-3">Fecha</dt>
        <dd class="col-sm-9">@Model.Cita.FechaDeLaCita.ToString("f")</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Cita.Id" />
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Eliminar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>
