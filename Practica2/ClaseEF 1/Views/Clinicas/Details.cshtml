@model ClaseEF.Models.Clinica
@{
    ViewData["Title"] = "Detalle clinica";
}

<div class="form-card p-4">
    <h1 class="h3">Detalle de clinica</h1>
    <dl class="row mb-0">
        <dt class="col-sm-3">Id</dt>
        <dd class="col-sm-9">@Model.Id</dd>
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>
        <dt class="col-sm-3">Direccion</dt>
        <dd class="col-sm-9">@Model.Direccion</dd>
    </dl>
    <div class="mt-3 d-flex gap-2">
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Editar</a>
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
    </div>
</div>
