@model IEnumerable<pruebaCaso1.Models.Habitacion>
@{
    ViewData["Title"] = "Habitaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Habitaciones</h1>
        <p class="text-muted mb-0">Administración de habitaciones del hotel.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nueva habitación</a>
</div>

@if (TempData["SuccessMessageHabitacion"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessageHabitacion"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Ubicación</th>
                <th>Huéspedes</th>
                <th>Camas</th>
                <th>Baños</th>
                <th>Responsable limpieza</th>
                <th>Costo limpieza</th>
                <th>Costo reserva</th>
                <th>Tipo</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CodigoDeHabitacion</td>
                    <td>@item.NombreDeHabitacion</td>
                    <td>@item.Ubicacion</td>
                    <td>@item.CantidadDeHuespedesPermitidos</td>
                    <td>@item.CantidadDeCamas</td>
                    <td>@item.CantidadDeBanos</td>
                    <td>@item.EncargadoDeLimpieza</td>
                    <td>@item.CostoDeLimpieza.ToString("C")</td>
                    <td>@item.CostoDeReserva.ToString("C")</td>
                    <td>
                        @(item.TipoDeHabitacion == 1 ? "Junior" :
                          item.TipoDeHabitacion == 2 ? "Superior" : "Suite")
                    </td>
                    <td>@(item.Estado ? "Activo" : "Inactivo")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-secondary" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a asp-action="FilterList" asp-route-id="@item.Id" class="btn btn-info">Ver Reservas</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>