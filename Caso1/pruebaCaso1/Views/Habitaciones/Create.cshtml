@model pruebaCaso1.Models.Habitacion
@{
    ViewData["Title"] = "Nueva Habitación";
}

<div class="form-card p-4">
    <h1 class="h3">Crear Habitación</h1>
    <form asp-action="Create" method="post">
        <div class="row g-3">
            <!-- Código de habitación -->
            <div class="col-md-4">
                <label asp-for="CodigoDeHabitacion" class="form-label">Código</label>
                <input asp-for="CodigoDeHabitacion" class="form-control" placeholder="Ej: H-1" />
                <span asp-validation-for="CodigoDeHabitacion" class="text-danger"></span>
            </div>

            <!-- Nombre de habitación -->
            <div class="col-md-4">
                <label asp-for="NombreDeHabitacion" class="form-label">Nombre</label>
                <input asp-for="NombreDeHabitacion" class="form-control" placeholder="Habitación Simple" />
                <span asp-validation-for="NombreDeHabitacion" class="text-danger"></span>
            </div>

            <!-- Ubicación -->
            <div class="col-md-4">
                <label asp-for="Ubicacion" class="form-label">Ubicación</label>
                <input asp-for="Ubicacion" class="form-control" placeholder="Piso 1" />
                <span asp-validation-for="Ubicacion" class="text-danger"></span>
            </div>

            <!-- Cantidad de huéspedes permitidos -->
            <div class="col-md-3">
                <label asp-for="CantidadDeHuespedesPermitidos" class="form-label">Huéspedes permitidos</label>
                <input asp-for="CantidadDeHuespedesPermitidos" class="form-control" type="number" min="1" />
                <span asp-validation-for="CantidadDeHuespedesPermitidos" class="text-danger"></span>
            </div>

            <!-- Cantidad de camas -->
            <div class="col-md-3">
                <label asp-for="CantidadDeCamas" class="form-label">Camas</label>
                <input asp-for="CantidadDeCamas" class="form-control" type="number" min="1" />
                <span asp-validation-for="CantidadDeCamas" class="text-danger"></span>
            </div>

            <!-- Cantidad de baños -->
            <div class="col-md-3">
                <label asp-for="CantidadDeBanos" class="form-label">Baños</label>
                <input asp-for="CantidadDeBanos" class="form-control" type="number" min="1" />
                <span asp-validation-for="CantidadDeBanos" class="text-danger"></span>
            </div>

            <!-- Tipo de habitación-->
            <div class="col-md-3">
                <label asp-for="TipoDeHabitacion" class="form-label">Tipo</label>
                <select asp-for="TipoDeHabitacion" class="form-select">
                    <option value="">Seleccione...</option>
                    <option value="1">Junior</option>
                    <option value="2">Superior</option>
                    <option value="3">Suite</option>
                </select>
                <span asp-validation-for="TipoDeHabitacion" class="text-danger"></span>
            </div>

            <!-- Encargado de limpieza -->
            <div class="col-md-6">
                <label asp-for="EncargadoDeLimpieza" class="form-label">Encargado de limpieza</label>
                <input asp-for="EncargadoDeLimpieza" class="form-control" placeholder="Nombre completo" />
                <span asp-validation-for="EncargadoDeLimpieza" class="text-danger"></span>
            </div>

            <!-- Costo de limpieza -->
            <div class="col-md-3">
                <label asp-for="CostoDeLimpieza" class="form-label">Costo limpieza</label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="CostoDeLimpieza" class="form-control" type="number" step="0.01" min="1.00" />
                </div>
                <span asp-validation-for="CostoDeLimpieza" class="text-danger"></span>
            </div>

            <!-- Costo de reserva -->
            <div class="col-md-3">
                <label asp-for="CostoDeReserva" class="form-label">Costo reserva (por noche)</label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input asp-for="CostoDeReserva" class="form-control" type="number" step="0.01" min="1.00" />
                </div>
                <span asp-validation-for="CostoDeReserva" class="text-danger"></span>
            </div>

            <!-- Estado -->
            <div class="col-md-12">
                <label asp-for="Estado" class="form-label">Estado</label>
                <select asp-for="Estado" class="form-select">
                    <option value="true">Activo</option>
                    <option value="false">Inactivo</option>
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}