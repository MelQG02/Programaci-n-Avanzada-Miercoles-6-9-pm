@model pruebaCaso1.ViewModels.ReservarViewModel
@{
    ViewData["Title"] = "Nueva Reservación";
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index">← Volver</a>
    <h1 class="h3 mb-0">Nueva Reservación</h1>
</div>

<div class="alert alert-info mb-4">
    <div class="row g-2">
        <div class="col-auto">
            <strong>Habitación:</strong> @Model.Habitacion.NombreDeHabitacion
        </div>
        <div class="col-auto">
            <span class="text-muted">|</span>
            <strong>Código:</strong> @Model.Habitacion.CodigoDeHabitacion
        </div>
        <div class="col-auto">
            <span class="text-muted">|</span>
            <strong>Tipo:</strong>
            @(Model.Habitacion.TipoDeHabitacion == 1 ? "Junior" :
              Model.Habitacion.TipoDeHabitacion == 2 ? "Superior" : "Suite")
        </div>
        <div class="col-auto">
            <span class="text-muted">|</span>
            <strong>Costo por noche:</strong> @Model.Habitacion.CostoDeReserva.ToString("C")
        </div>
        <div class="col-auto">
            <span class="text-muted">|</span>
            <strong>Costo limpieza:</strong> @Model.Habitacion.CostoDeLimpieza.ToString("C")
        </div>
    </div>
</div>

<div class="form-card p-4">
    
    <form asp-controller="Reservaciones" asp-action="ReservePost" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Reservacion.IdHabitacion" />

        <h5 class="mb-3">Datos personales del cliente</h5>
        <div class="row g-3">

            <div class="col-md-6">
                <label asp-for="Reservacion.NombreDeLaPersona" class="form-label">Nombre completo</label>
                <input asp-for="Reservacion.NombreDeLaPersona" class="form-control" placeholder="Juan Pérez González" />
                <span asp-validation-for="Reservacion.NombreDeLaPersona" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Reservacion.Identificacion" class="form-label">Identificación</label>
                <input asp-for="Reservacion.Identificacion" class="form-control" placeholder="1-1234-5678" />
                <span asp-validation-for="Reservacion.Identificacion" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Reservacion.Telefono" class="form-label">Teléfono</label>
                <input asp-for="Reservacion.Telefono" class="form-control" placeholder="88887777" maxlength="10" />
                <span asp-validation-for="Reservacion.Telefono" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Reservacion.Correo" class="form-label">Correo electrónico</label>
                <input asp-for="Reservacion.Correo" class="form-control" type="email" placeholder="correo@ejemplo.com" />
                <span asp-validation-for="Reservacion.Correo" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="Reservacion.FechaNacimiento" class="form-label">Fecha de nacimiento</label>
                <input asp-for="Reservacion.FechaNacimiento" class="form-control" type="date" />
                <span asp-validation-for="Reservacion.FechaNacimiento" class="text-danger"></span>
            </div>

            <div class="col-md-9">
                <label asp-for="Reservacion.Direccion" class="form-label">Dirección</label>
                <input asp-for="Reservacion.Direccion" class="form-control" placeholder="San José, Costa Rica" />
                <span asp-validation-for="Reservacion.Direccion" class="text-danger"></span>
            </div>
        </div>

        <hr class="my-4" />
        <h5 class="mb-3">Datos de la reserva</h5>
        <div class="row g-3">

            <div class="col-md-4">
                <label asp-for="Reservacion.FechaInicioReserva" class="form-label">Fecha de inicio</label>
                <input asp-for="Reservacion.FechaInicioReserva" class="form-control" type="date" id="fechaInicio" />
                <span asp-validation-for="Reservacion.FechaInicioReserva" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Reservacion.FechaFinReserva" class="form-label">Fecha de fin</label>
                <input asp-for="Reservacion.FechaFinReserva" class="form-control" type="date" id="fechaFin" />
                <span asp-validation-for="Reservacion.FechaFinReserva" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label class="form-label">Monto total estimado</label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                 
                    <input id="montoEstimado" class="form-control bg-light" readonly value="--" />
                </div>
                <small class="text-muted">Se calcula automáticamente según las fechas.</small>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Guardar reservación</button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>

        const costoNoche = parseFloat("@Model.Habitacion.CostoDeReserva".replace(",", "."));
        const costoLimpieza = parseFloat("@Model.Habitacion.CostoDeLimpieza".replace(",", "."));

        const fechaInicio = document.getElementById("fechaInicio");
        const fechaFin = document.getElementById("fechaFin");
        const monto = document.getElementById("montoEstimado");

        function calcularMonto() {

            if (fechaInicio.value === "" || fechaFin.value === "") {
                monto.value = "";
                return;
            }

            let inicio = new Date(fechaInicio.value);
            let fin = new Date(fechaFin.value);

            let dias = (fin - inicio) / (1000 * 60 * 60 * 24);

            if (dias <= 0) {
                monto.value = "";
                return;
            }

            let total = (dias * costoNoche) + costoLimpieza;

            monto.value = total.toLocaleString("es-CR", {
                minimumFractionDigits:2,
                maximumFractionDigits:2
            });
        }

        fechaInicio.addEventListener("change", calcularMonto);
        fechaFin.addEventListener("change", calcularMonto);

    </script>
}