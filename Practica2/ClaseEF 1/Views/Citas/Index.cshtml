@model IEnumerable<ClaseEF.ViewModels.CitaListItemViewModel>
@{
    ViewData["Title"] = "Citas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Citas</h1>
        <p class="text-muted mb-0">CRUD sobre <code>dbo.CITAS</code> usando Entity Framework Core.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nueva cita</a>
</div>

<div class="table-card p-3">
    <table class="table table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Id</th>
                <th>Persona</th>
                <th>Servicio</th>
                <th>Fecha cita</th>
                <th>Monto</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Cita.Id</td>
                <td>@item.NombrePaciente</td>
                <td>@item.NombreServicio</td>
                <td>@item.Cita.FechaDeLaCita.ToString("g")</td>
                <td>@item.Cita.MontoTotal.ToString("C")</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.Cita.Id">Ver</a>
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@item.Cita.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@item.Cita.Id">Eliminar</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
