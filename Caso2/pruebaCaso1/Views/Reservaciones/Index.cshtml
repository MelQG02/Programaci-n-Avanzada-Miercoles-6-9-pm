@model pruebaCaso1.ViewModels.ReservacionIndexViewModel
@{
    ViewData["Title"] = "Reservaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Reservaciones</h1>
        <p class="text-muted mb-0">Seleccione una habitación disponible para realizar su reserva.</p>
    </div>

    <form asp-action="BuscarReserva" method="post" class="d-flex gap-2 align-items-center">
        <input type="number" name="idReservacion" class="form-control" placeholder="N.º de reservación" min="1" required style="width:190px" />
        <button type="submit" class="btn btn-outline-primary text-nowrap">Buscar reserva</button>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@Model.MensajeError
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["SuccessMessageReservacion"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessageReservacion"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="table-card p-3">
    @if (!Model.Habitaciones.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-door-closed fs-1 d-block mb-2"></i>
            No hay habitaciones disponibles en este momento.
        </div>
    }
    else
    {
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Huéspedes</th>
                    <th>Camas</th>
                    <th>Baños</th>
                    <th>Ubicación</th>
                    <th>Costo por noche</th>
                    <th>Tipo</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Habitaciones)
                {
                    <tr>
                        <td>@item.NombreDeHabitacion</td>
                        <td>@item.CantidadDeHuespedesPermitidos</td>
                        <td>@item.CantidadDeCamas</td>
                        <td>@item.CantidadDeBanos</td>
                        <td>@item.Ubicacion</td>
                        <td>@item.CostoDeReserva.ToString("C")</td>
                        <td>
                            @(item.TipoDeHabitacion == 1 ? "Junior" :
                              item.TipoDeHabitacion == 2 ? "Superior" : "Suite")
                        </td>
                        <td class="text-end">
                            <a asp-action="Reserve" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Reservar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>